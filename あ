const GH_BASE =
  "https://raw.githubusercontent.com/supermanone-boop/model/main/";

// ------------------------------
// GLOBAL SETTINGS
// ------------------------------

const BASE_LON = 135.442885;
const BASE_LAT = 34.790662;

const MAX_RADIUS = 2000;

const BRIGHTNESS = 1.18;

// ------------------------------
// MODEL DEFINITIONS
// ------------------------------

const KADO_CONFIG = [
  {
    name: "KADO1",
    url: HF_BASE + "kado_01.glb",

    lon: 135.442825,
    lat: 34.788936,
    height: 8.888973662526322,

