// ============================================================
// BUILD SLIDERS
// ============================================================

function buildControls() {

  if (!editorPanel) return;

  const entry =
    KADO_MODELS.find(
      item => item.name === selectedModel
    );

  const controls =
    editorPanel.querySelector(
      "#kado-controls"
    );

  if (!entry) {

    controls.innerHTML =
      "<div>このモデルは読み込まれていません。</div>";

    return;
  }

  controls.innerHTML = "";

  const definitions = [

    {
      label: "Longitude",
      key: "lon",
      min: BASE_LON - 0.025,
      max: BASE_LON + 0.025,
      step: 0.000001
    },

    {
      label: "Latitude",
      key: "lat",
      min: BASE_LAT - 0.025,
      max: BASE_LAT + 0.025,
      step: 0.000001
    },

    {
      label: "Altitude (m)",
      key: "height",
      min: -500,
      max: 20000,
      step: 0.1
    },

    {
      label: "Scale",
      key: "scale",
      min: 0.1,
      max: 100,
      step: 0.1
    },

    {
      label: "Rotation X",
      key: "rotationX",
      min: -180,
      max: 180,
      step: 1
    },

    {
      label: "Rotation Y",
      key: "rotationY",
      min: -180,
      max: 180,
      step: 1
    },

    {
      label: "Rotation Z",
      key: "rotationZ",
      min: -180,
      max: 180,
      step: 1
    }

  ];

  for (const definition of definitions) {

    const key = definition.key;

    const value = entry.settings[key];

    const row =
      document.createElement("div");

    row.style.cssText =
      "margin:13px 0;";

    row.innerHTML = `

      <div style="
        display:flex;
        justify-content:space-between;
        margin-bottom:5px;
      ">

        <span>${definition.label}</span>

        <span id="value-${key}">
          ${Number(value).toFixed(
            key === "lon" || key === "lat" ? 6 : 2
          )}
        </span>

      </div>

      <input
        type="range"
        id="input-${key}"
        min="${definition.min}"
        max="${definition.max}"
        step="${definition.step}"
        value="${value}"
        style="width:100%;"
      >

    `;

    controls.appendChild(row);

    const input =
      row.querySelector("input");

    input.addEventListener("input", () => {

      entry.settings[key] =
        Number(input.value);

      row.querySelector(
        "#value-" + key
      ).textContent =
        Number(input.value).toFixed(
          key === "lon" || key === "lat" ? 6 : 2
        );

      updateModel(entry);
    });
  }
}

// ============================================================
// RESET SELECTED MODEL
// ============================================================

function resetSelected() {

  const entry =
    KADO_MODELS.find(
      item => item.name === selectedModel
    );

  const original =
    KADO_CONFIG.find(
      item => item.name === selectedModel
    );

  if (!entry || !original) return;

  Object.assign(
    entry.settings,
    original
  );

  buildControls();

  updateModel(entry);

  console.log(
    "Reset:",
    selectedModel
  );
}

// ============================================================
// DISTANCE DISPLAY
// ============================================================

function updateEditorDistance() {

  if (!editorPanel) return;

  const entry =
    KADO_MODELS.find(
      item => item.name === selectedModel
    );

  if (!entry) return;

  const distance =
    getDistance(entry.settings);

  const distanceElement =
    editorPanel.querySelector(
      "#kado-distance"
    );

  const statusElement =
    editorPanel.querySelector(
      "#kado-status"
    );

  if (distanceElement) {

    distanceElement.textContent =
      "距離：" + distance.toFixed(1) + "m";

  }

  if (statusElement) {

    statusElement.textContent =
      distance <= MAX_RADIUS
        ? "移動範囲内 ✓"
        : "移動範囲外";

  }
}

// ============================================================
// REMOVE ALL MODELS
// ============================================================

function removeAllModels() {

  isRunning = false;

  if (animationFrame !== null) {

    cancelAnimationFrame(
      animationFrame
    );

    animationFrame = null;
  }

  for (const entry of KADO_MODELS) {

    viewer.scene.primitives.remove(
      entry.model
    );

  }

  KADO_MODELS = [];

  if (editorPanel) {

    editorPanel.remove();

    editorPanel = null;
  }

  console.log(
    "All KADO models removed."
  );
}

// ============================================================
// GLOBAL API
// ============================================================

window.KADO_MODELS_CONTROL = {

  list: function() {

    console.table(
      KADO_MODELS.map(entry => ({
        name: entry.name,
        lon: entry.settings.lon,
        lat: entry.settings.lat,
        height: entry.settings.height,
        scale: entry.settings.scale,
        rotationX: entry.settings.rotationX,
        rotationY: entry.settings.rotationY,
        rotationZ: entry.settings.rotationZ
      }))
    );
  },

  update: function(name, values) {

    const entry =
      KADO_MODELS.find(
        item => item.name === name
      );

    if (!entry) {

      console.error(
        "Model not found:",
        name
      );

      return;
    }

    Object.assign(
      entry.settings,
      values
    );

    updateModel(entry);

    if (
      editorPanel &&
      selectedModel === name
    ) {
      buildControls();
    }
  },

  remove: removeAllModels,

  brightness: function(value) {

    const amount =
      Number(value);

    if (
      !Number.isFinite(amount) ||
      amount < 0 ||
      amount > 2
    ) {
      console.error(
        "Brightness must be between 0 and 2."
      );

      return;
    }

    for (const entry of KADO_MODELS) {

      entry.model.color =
        new Cesium.Color(
          amount,
          amount,
          amount,
          1
        );
    }

    console.log(
      "Brightness:",
      amount
    );
  }

};

