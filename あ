let selectedModel = "KADO1";

// ============================================================
// DISTANCE CALCULATION
// ============================================================

const centerPosition =
  Cesium.Cartesian3.fromDegrees(
    BASE_LON,
    BASE_LAT,
    0
  );

function getDistance(settings) {

  const target =
    Cesium.Cartesian3.fromDegrees(
      settings.lon,
      settings.lat,
      0
    );

  return Cesium.Cartesian3.distance(
    centerPosition,
    target
  );
}

// ============================================================
// POSITION LIMIT
// ============================================================

function limitPosition(settings) {

  const distance = getDistance(settings);

  if (distance <= MAX_RADIUS) {
    return;
  }

  const target =
    Cesium.Cartesian3.fromDegrees(
      settings.lon,
      settings.lat,
      0
    );

  const direction =
    Cesium.Cartesian3.subtract(
      target,
      centerPosition,
      new Cesium.Cartesian3()
    );

  Cesium.Cartesian3.normalize(
    direction,
    direction
  );

  const limited =
    Cesium.Cartesian3.add(
      centerPosition,
      Cesium.Cartesian3.multiplyByScalar(
        direction,
        MAX_RADIUS,
        new Cesium.Cartesian3()
      ),
      new Cesium.Cartesian3()
    );

  const cartographic =
    Cesium.Cartographic.fromCartesian(
      limited
    );

  settings.lon =
    Cesium.Math.toDegrees(
      cartographic.longitude
    );

  settings.lat =
    Cesium.Math.toDegrees(
      cartographic.latitude
    );
}

// ============================================================
// MODEL MATRIX
// ============================================================

function updateModel(entry) {

  if (!entry || !entry.model) return;

  const settings = entry.settings;

  limitPosition(settings);

  const position =
    Cesium.Cartesian3.fromDegrees(
      settings.lon,
      settings.lat,
      settings.height
    );

  const hpr =
    new Cesium.HeadingPitchRoll(
      Cesium.Math.toRadians(
        settings.rotationZ
      ),
      Cesium.Math.toRadians(
        settings.rotationX
      ),
      Cesium.Math.toRadians(
        settings.rotationY
      )
    );

  const rotation =
    Cesium.Transforms.headingPitchRollQuaternion(
      position,
      hpr
    );

  const matrix =
    Cesium.Matrix4.fromTranslationQuaternionRotationScale(
      position,
      rotation,
      new Cesium.Cartesian3(
        settings.scale,
        settings.scale,
        settings.scale
      )
    );

  entry.model.modelMatrix = matrix;
}

// ============================================================
// BRIGHTNESS CORRECTION
// ============================================================

function brightenModel(model) {

  // Cesium model color highlight
  // This is a display tint, not a texture edit.

  model.color = new Cesium.Color(
    BRIGHTNESS,
    BRIGHTNESS,
    BRIGHTNESS,
    1
  );

  if (
    Cesium.ModelColorBlendMode &&
    Cesium.ModelColorBlendMode.HIGHLIGHT !== undefined
  ) {

    model.colorBlendMode =
      Cesium.ModelColorBlendMode.HIGHLIGHT;

    model.colorBlendAmount = 0.18;
  }
}

// ============================================================
// LOAD MODEL
// ============================================================

async function loadModel(config) {

  console.log(
    "Loading " + config.name,
    config.url
  );

  const model =
    await Cesium.Model.fromGltf({

      url: config.url,

      modelMatrix: Cesium.Matrix4.IDENTITY,

      scale: 1
    });

  viewer.scene.primitives.add(model);

  const entry = {

    name: config.name,

    settings: Object.assign({}, config),

    model: model,

    loaded: true
  };

  KADO_MODELS.push(entry);

  brightenModel(model);

  updateModel(entry);

  console.log(
    "Loaded successfully:",
    config.name
  );

  return entry;
}

// ============================================================
// LOAD ALL MODELS
// ============================================================

async function loadAllModels() {

  viewer = geofs.api.viewer;

  console.log(
    "KADO MODEL SYSTEM START"
  );

  for (const config of KADO_CONFIG) {

    try {

      await loadModel(config);

    } catch (error) {

      console.error(
        "FAILED:",
        config.name,
        error
      );

    }
  }

  createEditor();

  startUpdate();

  console.log(
    "KADO SYSTEM READY"
  );

  console.table(
    KADO_MODELS.map(entry => ({
      name: entry.name,
      longitude: entry.settings.lon,
      latitude: entry.settings.lat,
      altitude: entry.settings.height,
      scale: entry.settings.scale,
      rotationZ: entry.settings.rotationZ
    }))
  );
}

// ============================================================
// CONTINUOUS UPDATE
// ============================================================

function startUpdate() {

  if (isRunning) return;

  isRunning = true;

  function loop() {

    if (!isRunning) return;

    for (const entry of KADO_MODELS) {

      updateModel(entry);

    }

    updateEditorDistance();

    animationFrame =
      requestAnimationFrame(loop);
  }

  loop();
}

